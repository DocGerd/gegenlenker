{
  "permissions": {
    "deny": ["Edit(pnpm-lock.yaml)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.sh"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
