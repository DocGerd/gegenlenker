{
  "name": "gegenlenker",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path \"$(git rev-parse --git-path info/exclude)\"",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path \"$(git rev-parse --git-path info/exclude)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project offline",
    "test:perf": "playwright test --project perf",
    "icons": "node scripts/icons.mjs",
    "estimates": "node scripts/estimates.mjs",
    "cab:params": "node scripts/cab-params.mjs",
    "cab:optimise": "node scripts/cab-optimise.mjs",
    "cab:manifest": "node scripts/cab-manifest.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "three": "^0.187.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
