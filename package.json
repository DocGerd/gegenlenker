{
  "name": "gegenlenker",
  "version": "1.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:stop": "node scripts/preview-stop.mjs",
    "shoot": "node scripts/shoot.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project offline",
    "test:e2e:channels": "E2E_CHANNELS=1 playwright test --project channels",
    "test:e2e:webgpu": "playwright test --project webgpu",
    "test:perf": "playwright test --project perf",
    "perf:tablet": "node e2e/perf/tablet-emulation.ts",
    "icons": "node scripts/icons.mjs",
    "estimates": "node scripts/estimates.mjs",
    "changelog": "node scripts/changelog.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:cut": "node scripts/release-cut.mjs",
    "release:backmerge": "node scripts/release-backmerge.mjs",
    "hotfix:cut": "node scripts/hotfix-cut.mjs",
    "credits": "node scripts/credits.mjs",
    "glb:params": "node scripts/glb-params.mjs",
    "glb:optimise": "node scripts/glb-optimise.mjs",
    "glb:manifest": "node scripts/glb-manifest.mjs",
    "texture": "node scripts/texture.mjs",
    "assets:fetch": "node scripts/fetch-asset-sources.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm test:e2e",
    "verify:layout": "vitest run --config vitest.verify.config.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "three": "^0.187.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "ktx-parse": "2.0.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
